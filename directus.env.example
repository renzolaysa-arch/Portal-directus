# Copiar a directus.env y completar. directus.env no se sube al repositorio.

# openssl rand -hex 32
KEY=
SECRET=

# en el servidor, la URL real (https://.../directus)
PUBLIC_URL=http://localhost:8055

DB_CLIENT=mssql
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_OPTIONS__encrypt=true
DB_OPTIONS__trustServerCertificate=true

# el limite por defecto (6000 px) deja sin redimensionar algunas fotos
ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=8000

CACHE_ENABLED=false
STORAGE_LOCAL_ROOT=/directus/uploads

# en produccion, el dominio del portal
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

ACCESS_TOKEN_TTL=15m

# Produccion

RATE_LIMITER_ENABLED=true
RATE_LIMITER_STORE=memory
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1

# igual que el tope del servidor web
FILES_MAX_UPLOAD_SIZE=50mb
MAX_PAYLOAD_SIZE=50mb

LOG_LEVEL=info
LOG_STYLE=raw

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_TTL=7d

TELEMETRY=false

# CACHE_ENABLED=true
# CACHE_TTL=5m
# CACHE_AUTO_PURGE=true
