# Plantilla de configuracion de Directus. Copia este archivo a "directus.env"
# (mismo nombre que usa docker-compose.yml) y completa los valores reales.
# directus.env NUNCA se versiona: esta en .gitignore.

# Generar con: openssl rand -hex 32   (o cualquier cadena aleatoria larga)
KEY=
SECRET=

# URL publica por la que se accede a este Directus. En local:
# http://localhost:8055. En el servidor, la URL real (https://...).
PUBLIC_URL=http://localhost:8055

# Base de datos. Este proyecto usa SQL Server (mssql); DB_HOST usa
# host.docker.internal para hablar con un SQL Server que corre en la
# maquina host, fuera del contenedor de Directus.
DB_CLIENT=mssql
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_OPTIONS__encrypt=true
DB_OPTIONS__trustServerCertificate=true

CACHE_ENABLED=false
STORAGE_LOCAL_ROOT=/directus/uploads

# CORS: dominios desde los que el portal puede llamar a esta API.
# En local, el puerto de Vite; en produccion, el dominio real del portal.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

ACCESS_TOKEN_TTL=15m
