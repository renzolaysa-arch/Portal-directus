# Plantilla de configuracion de Directus. Copia este archivo a "directus.env"
# (mismo nombre que usa docker-compose.yml) y completa los valores reales.
# directus.env NUNCA se versiona: esta en .gitignore.

# Generar con: openssl rand -hex 32   (o cualquier cadena aleatoria larga)
KEY=
SECRET=

# URL publica por la que se accede a este Directus. En local:
# http://localhost:8055. En el servidor, la URL real (https://...).
PUBLIC_URL=http://localhost:8055

# Base de datos. Este proyecto usa SQL Server (mssql); DB_HOST usa
# host.docker.internal para hablar con un SQL Server que corre en la
# maquina host, fuera del contenedor de Directus.
DB_CLIENT=mssql
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_OPTIONS__encrypt=true
DB_OPTIONS__trustServerCertificate=true

# Tope de tamano para redimensionar imagenes. Por defecto Directus se niega a
# transformar cualquier original de mas de 6000 px, y el repositorio tiene una
# foto de 6016x4016 que caia justo encima: se servia entera (1.8 MB) en vez de
# redimensionada. Ojo al nombre, es IMAGE_MAX y no MAX_IMAGE.
ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=8000

CACHE_ENABLED=false
STORAGE_LOCAL_ROOT=/directus/uploads

# CORS: dominios desde los que el portal puede llamar a esta API.
# En local, el puerto de Vite; en produccion, el dominio real del portal.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

ACCESS_TOKEN_TTL=15m

# ============================================================================
# ENDURECIMIENTO PARA PRODUCCION
# ----------------------------------------------------------------------------
# Las variables de abajo no hacen falta en local, pero sus valores por defecto
# no son los adecuados para un portal publico. Revisalas antes del pase.
# ============================================================================

# Limite de peticiones. Sin el, /auth/login acepta intentos de contrasena sin
# freno: es la unica puerta de escritura del portal y esta abierta a internet.
RATE_LIMITER_ENABLED=true
RATE_LIMITER_STORE=memory
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1

# Tamano maximo de los archivos que suben los editores. Por defecto no hay
# tope efectivo y un PDF de varios cientos de MB llena el disco del servidor.
FILES_MAX_UPLOAD_SIZE=50mb
MAX_PAYLOAD_SIZE=50mb

# Registro. "info" evita volcar cada consulta; "json" facilita que el servidor
# los recoja. En "debug" Directus imprime datos de las peticiones en el log.
LOG_LEVEL=info
LOG_STYLE=raw

# La cookie de sesion solo viaja por https y no la lee JavaScript de terceros.
# SESSION_COOKIE_SAME_SITE=lax permite que el portal y la API compartan dominio.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# Duracion de la sesion de los editores. El valor corto de arriba
# (ACCESS_TOKEN_TTL) obliga a renovar; este marca cuanto dura la renovacion.
REFRESH_TOKEN_TTL=7d

# Directus envia estadisticas de uso a sus servidores si no se apaga. En un
# sistema institucional eso se decide, no se hereda del valor por defecto.
TELEMETRY=false

# Cache. En produccion conviene encenderla: el portal es de solo lectura para
# el visitante y las mismas consultas se repiten en cada visita.
# CACHE_ENABLED=true
# CACHE_TTL=5m
# CACHE_AUTO_PURGE=true
